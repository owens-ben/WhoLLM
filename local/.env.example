# Copy to local/.env and fill in for your household. local/.env is git-ignored.

# --- Dashboard (used by: docker compose --env-file ../local/.env up -d) ---
# Home Assistant base URL, no trailing slash
HA_URL=http://homeassistant.local:8123
DASHBOARD_PORT=3380

# --- Integration deploy (used by: scripts/deploy.sh) ---
# SSH target for the Home Assistant host
HA_SSH=root@homeassistant.local
# HA config directory on that host
HA_CONFIG_DIR=/config
# Command run over SSH after copying, e.g. "ha core restart" (HA OS)
# or "docker restart homeassistant" (container). Leave empty to skip.
HA_RESTART_CMD=
